<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuracao do IIS para hospedar a API.
  O publish do ASP.NET Core injeta automaticamente a secao <aspNetCore> (ANCM);
  aqui mantemos apenas os ajustes especificos da aplicacao.

  requestLimits/maxAllowedContentLength: o limite padrao do IIS e ~28,6 MB e
  retorna 413 (Payload Too Large) ANTES da requisicao chegar ao ASP.NET Core,
  bloqueando a importacao dos CSVs anuais da CVM (DRE e demais demonstracoes).
  Alinhamos com o limite do controller DfpController (1 GiB).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
